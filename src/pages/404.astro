---
import Button from "@core-elements/button/Button.astro";
import seoData from "@data/seo.json";
import Docs from "@layouts/Docs.astro";
import { getDocsNav } from "@utils/docsNav";

const canonical = new URL("/404.html", Astro.site ?? seoData.url).href;
const nav = await getDocsNav();

// The most-read links a reader is likely to have been heading for. Hand-picked
// rather than derived — the first four pages in the sidebar are rarely the
// four people land on from a stale link.
const popular = ["/installation/", "/configuration/", "/config-api/", "/media-and-components/"];
const popularPages = nav.reading.filter((page) => popular.includes(page.href));
---

<Docs
  nav={nav}
  title="Page not found"
  description="This URL does not exist on this site. Search the documentation or go back to the overview."
  canonical={canonical}
  noindex={true}
  wide={true}
>
  <div class="not-found">
    <p class="not-found-code">404</p>
    <h1>That page moved, or never existed.</h1>
    <p class="not-found-lede">
      Documentation URLs are permanent by policy — a renamed page gets a redirect. If you followed a
      link here, search will find where it went.
    </p>
    <div class="not-found-actions">
      <Button
        text="Search the docs"
        link="^search-modal"
        variant="primary"
        size="md"
      />
      <Button
        text="Back to overview"
        link="/"
        variant="secondary"
        size="md"
      />
    </div>

    {
      popularPages.length > 0 && (
        <div class="not-found-popular">
          <p class="not-found-popular-label">Most-read pages</p>
          <ul>
            {popularPages.map((page) => (
              <li>
                <a href={page.href}>{page.title}</a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</Docs>

<style>
  .not-found {
    max-width: 40rem;
    padding-block: var(--spacing-3xl);
  }

  .not-found-code {
    color: var(--color-text-faint);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-wide);
    margin: 0;
  }

  .not-found h1 {
    margin-top: var(--spacing-sm);
  }

  .not-found-lede {
    color: var(--color-text-muted);
    font-size: var(--font-size-lg);
    margin: 0;
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
    margin-top: var(--spacing-xl);
  }

  .not-found-popular {
    border-top: var(--border-width-sm) solid var(--color-border);
    margin-top: var(--spacing-2xl);
    padding-top: var(--spacing-lg);
  }

  .not-found-popular-label {
    color: var(--color-text-faint);
    font-size: var(--font-size-sm);
    margin: 0 0 var(--spacing-sm);
  }

  .not-found-popular ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-lg);
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
