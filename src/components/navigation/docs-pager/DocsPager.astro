---
/**
 * Previous/next links across the sidebar's reading order. Site chrome fed by
 * `findPager()` — no CloudCannon YAML.
 */
import type { DocsNavPage } from "@utils/docsNav";

const {
  prev,
  next,
  class: className,
  ...htmlAttributes
} = Astro.props as {
  prev?: DocsNavPage;
  next?: DocsNavPage;
  class?: string;
  [key: string]: unknown;
};

if (!prev && !next) return;
---

<nav
  class:list={["docs-pager", className]}
  aria-label="Documentation pages"
  {...htmlAttributes}
>
  {
    prev && (
      <a
        href={prev.href}
        rel="prev"
        class="docs-pager-link is-prev"
      >
        <span class="docs-pager-label">Previous</span>
        <span class="docs-pager-title">{prev.title}</span>
      </a>
    )
  }
  {
    next && (
      <a
        href={next.href}
        rel="next"
        class="docs-pager-link is-next"
      >
        <span class="docs-pager-label">Next</span>
        <span class="docs-pager-title">{next.title}</span>
      </a>
    )
  }
</nav>

<style is:global>
  @layer components {
    .docs-pager {
      display: grid;
      gap: var(--spacing-md);
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-top: var(--spacing-xl);
    }

    .docs-pager-link {
      border: var(--border-width-sm) solid var(--color-border);
      border-radius: var(--radius-md);
      display: flex;
      flex-direction: column;
      gap: var(--spacing-xs);
      padding: var(--spacing-md);
      text-decoration: none;
      transition:
        border-color var(--animation-fast) var(--ease-out),
        transform var(--animation-fast) var(--ease-out);

      &:hover {
        border-color: var(--color-border-strong);
        transform: translateY(-2px);
      }

      /* A lone "next" belongs on the right, where a reader looks for it. */
      &.is-next {
        grid-column: 2;
        text-align: end;
      }
    }

    .docs-pager-label {
      color: var(--color-text-faint);
      font-size: var(--font-size-xs);
    }

    .docs-pager-title {
      color: var(--color-text-strong);
      font-size: var(--font-size-sm);
      font-weight: var(--font-weight-semibold);
    }

    @media (width < 640px) {
      .docs-pager {
        grid-template-columns: minmax(0, 1fr);
      }

      .docs-pager-link.is-next {
        grid-column: 1;
      }
    }
  }
</style>
