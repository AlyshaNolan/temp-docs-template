---
/**
 * "Copy page" — a dropdown handing the page somewhere else: as Markdown, as a
 * ready-made prompt, as a link, as the raw `.md` file, or onto paper.
 *
 * Docs chrome like `page-feedback`: no CloudCannon YAML, placed by
 * `src/pages/[...slug].astro` and switched on in `src/data/docsSite.json`.
 * It ships `hidden` and is revealed by `setup.ts` — every item needs the
 * clipboard or a fetch, so with JS off the reader sees nothing rather than a
 * dead control. The Markdown itself stays reachable at `markdownHref`.
 */
import Icon from "@core-elements/icon/Icon.astro";

const { label = "Copy page", markdownHref, class: className, ...htmlAttributes } = Astro.props;

const menuId = "copy-page-menu";

const copyItems = [
  {
    action: "markdown",
    icon: "document-text",
    label: "Copy as Markdown",
    hint: "The page content as Markdown",
  },
  {
    action: "prompt",
    icon: "sparkles",
    label: "Copy for LLM prompt",
    hint: "Markdown wrapped in context",
  },
  {
    action: "link",
    icon: "link",
    label: "Copy link",
    hint: "This page's URL",
  },
];
---

<div
  class:list={["copy-page", className]}
  data-markdown-href={markdownHref}
  data-pagefind-ignore
  hidden
  {...htmlAttributes}
>
  <button
    type="button"
    class="copy-page-trigger"
    aria-expanded="false"
    aria-haspopup="menu"
    aria-controls={menuId}
  >
    <Icon
      name="clipboard-document"
      size="none"
    />
    <span class="copy-page-labels">
      <span class="copy-page-trigger-idle">{label}</span>
      <span class="copy-page-trigger-done">Copied</span>
      <span class="copy-page-trigger-failed">Copy failed</span>
    </span>
    <Icon
      name="chevron-down"
      size="none"
      class="copy-page-caret"
    />
  </button>

  <div
    class="copy-page-menu"
    id={menuId}
    role="menu"
    hidden
  >
    {
      copyItems.map((item) => (
        <button
          type="button"
          class="copy-page-item"
          role="menuitem"
          data-action={item.action}
        >
          <Icon
            name={item.icon}
            size="none"
          />
          <span class="copy-page-item-text">
            <span class="copy-page-item-label">{item.label}</span>
            <span class="copy-page-item-hint">{item.hint}</span>
          </span>
        </button>
      ))
    }
    <hr
      class="copy-page-divider"
      role="separator"
    />

    <a
      class="copy-page-item"
      role="menuitem"
      href={markdownHref}
    >
      <Icon
        name="arrow-top-right-on-square"
        size="none"
      />
      <span class="copy-page-item-text">
        <span class="copy-page-item-label">Open Markdown</span>
        <span class="copy-page-item-hint">The raw .md file</span>
      </span>
    </a>

    <button
      type="button"
      class="copy-page-item"
      role="menuitem"
      data-action="print"
    >
      <Icon
        name="printer"
        size="none"
      />
      <span class="copy-page-item-text">
        <span class="copy-page-item-label">Print page</span>
        <span class="copy-page-item-hint">Opens the print layout</span>
      </span>
    </button>
  </div>

  <p
    class="copy-page-status visually-hidden"
    role="status"
  >
  </p>
</div>

<script>
  import { onPageLoad } from "@component-utils/onPageLoad";
  import { setupAllCopyPage } from "./setup";

  onPageLoad(setupAllCopyPage);
</script>

<style is:global>
  @layer components {
    .copy-page {
      --copy-page-menu-width: 17rem;

      position: relative;
    }

    .copy-page-trigger {
      align-items: center;
      background-color: var(--color-bg);
      border: var(--border-width-sm) solid var(--color-border);
      border-radius: var(--radius-md);
      color: var(--color-text-muted);
      cursor: pointer;
      display: flex;
      font: inherit;
      font-size: var(--font-size-sm);
      gap: var(--spacing-xs);
      padding: var(--spacing-xs) var(--spacing-md);
      transition:
        border-color var(--animation-fast) var(--ease-out),
        color var(--animation-fast) var(--ease-out);
      white-space: nowrap;

      &:hover {
        border-color: var(--color-border-strong);
        color: var(--color-text-strong);
      }

      .copy-page-caret {
        transition: transform var(--animation-fast) var(--ease-out);
      }

      &[aria-expanded="true"] .copy-page-caret {
        transform: rotate(180deg);
      }
    }

    /* One trigger, three labels, stacked in one grid cell: the button is as
       wide as its longest state, so copying can't resize it under the cursor. */
    .copy-page-labels {
      display: grid;

      > span {
        grid-area: 1 / 1;
      }
    }

    .copy-page-trigger-done,
    .copy-page-trigger-failed,
    .copy-page[data-state] .copy-page-trigger-idle {
      visibility: hidden;
    }

    .copy-page[data-state="copied"] .copy-page-trigger-done,
    .copy-page[data-state="failed"] .copy-page-trigger-failed {
      visibility: visible;
    }

    .copy-page[data-state="copied"] .copy-page-trigger {
      color: var(--color-success);
    }

    .copy-page[data-state="failed"] .copy-page-trigger {
      color: var(--color-danger);
    }

    .copy-page-menu {
      background-color: var(--color-bg-surface);
      border: var(--border-width-sm) solid var(--color-border);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-md);
      display: flex;
      flex-direction: column;
      inset-inline-end: 0;
      min-width: var(--copy-page-menu-width);
      padding: var(--spacing-xs);
      position: absolute;
      top: calc(100% + var(--spacing-xs));
      z-index: var(--layer-3);
    }

    /* No global `[hidden]` reset in this project, so the `display` above wins
       over the attribute and the menu would sit permanently open. */
    .copy-page-menu[hidden] {
      display: none;
    }

    .copy-page-item {
      align-items: start;
      background: none;
      border: 0;
      border-radius: var(--radius-sm);
      color: var(--color-text);
      cursor: pointer;
      display: flex;
      font: inherit;
      gap: var(--spacing-sm);
      padding: var(--spacing-sm);
      text-align: start;
      text-decoration: none;

      &:hover,
      &:focus-visible {
        background-color: var(--color-state-hover);
      }

      .icon {
        color: var(--color-text-faint);
        font-size: var(--font-size-md);
      }
    }

    .copy-page-divider {
      background-color: var(--color-border);
      border: 0;
      height: var(--border-width-sm);
      margin-block: var(--spacing-xs);
      width: 100%;
    }

    .copy-page-item-text {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-none);
    }

    .copy-page-item-label {
      font-size: var(--font-size-sm);
      font-weight: var(--font-weight-semibold);
      line-height: var(--line-height-tight);
    }

    .copy-page-item-hint {
      color: var(--color-text-muted);
      font-size: var(--font-size-xs);
      line-height: var(--line-height-normal);
    }
  }
</style>
