---
/**
 * A one-line site footer: legal text, links, socials. Docs pages carry their
 * own navigation in the sidebar, so the footer stays out of the way rather
 * than repeating it as a sitemap.
 */
import SocialLinks from "@core-elements/social-links/SocialLinks.astro";
import type { SocialLink } from "../../../types";

type FooterLink = { name?: string; path?: string };

const {
  links = [] as FooterLink[],
  socials = [] as SocialLink[],
  footerText = "",
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component,
  class: className,
  ...htmlAttributes
} = Astro.props;
---

<footer
  class:list={["footer", className]}
  {...htmlAttributes}
>
  <div class="footer-inner">
    {footerText && <p class="footer-text">{footerText}</p>}

    {
      links.length > 0 && (
        <nav
          class="footer-links"
          aria-label="Footer"
        >
          {(links as FooterLink[]).map((link) => (
            <a href={link.path}>{link.name}</a>
          ))}
        </nav>
      )
    }

    {
      socials.length > 0 && (
        <SocialLinks
          class="footer-socials"
          links={socials}
          variant="ghost"
          size="sm"
          alignmentHorizontal="end"
          useDefaultEditableBinding={false}
        />
      )
    }
  </div>
</footer>

<style is:global>
  @layer page-sections {
    .footer {
      border-top: var(--border-width-sm) solid var(--color-border);
      margin-top: var(--spacing-3xl);
    }

    .footer-inner {
      align-items: center;
      display: flex;
      flex-wrap: wrap;
      gap: var(--spacing-md);
      margin-inline: auto;
      max-width: var(--content-width-3xl);
      padding: var(--spacing-lg);
    }

    .footer-text {
      color: var(--color-text-faint);
      font-size: var(--font-size-sm);
      margin: 0;
      margin-inline-end: auto;
    }

    .footer-links {
      display: flex;
      flex-wrap: wrap;
      gap: var(--spacing-lg);

      a {
        color: var(--color-text-muted);
        font-size: var(--font-size-sm);
        text-decoration: none;

        &:hover {
          color: var(--color-text-strong);
        }
      }
    }

    @media (width < 640px) {
      .footer-text {
        margin-inline-end: 0;
        width: 100%;
      }
    }
  }
</style>
