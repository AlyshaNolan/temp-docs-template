---
/**
 * The fixed documentation header: drawer trigger, brand + version badge,
 * optional top-level links, search, theme toggle. Site chrome fed by
 * `src/data/header.json` — no CloudCannon YAML, wired by hand in `Docs.astro`.
 *
 * The editable regions bind to `@data[header]`, not the current file, so the
 * header is edited on canvas from whatever page is open. The prefix needs
 * `data_config.header` in `cloudcannon.config.yml`; `@file[<path>]` resolves
 * through `CloudCannon.file()` instead and does not answer to these paths.
 */
import { DOCS_NAV_TOGGLE_ID } from "@components/navigation/docs-sidebar/navToggle";
import Search from "@components/navigation/search/Search.astro";
import ThemeToggle from "@components/navigation/theme-toggle/ThemeToggle.astro";
import Icon from "@core-elements/icon/Icon.astro";
import Image from "@core-elements/image/Image.astro";

type TopbarLink = { name: string; path: string };

const {
  logoSource = "",
  logoAlternateSource = "",
  logoAlt = "",
  version = "",
  showVersionNumber = false,
  themeToggle = false,
  search = false,
  searchPlaceholder,
  topbarLinks = [] as TopbarLink[],
  pathname = "/",
  class: className,
  ...htmlAttributes
} = Astro.props;
---

<header
  class:list={["docs-topbar", className]}
  {...htmlAttributes}
>
  <label
    for={DOCS_NAV_TOGGLE_ID}
    class="docs-topbar-drawer-trigger"
    aria-hidden="true"
  >
    <Icon
      name="bars-3"
      size="none"
    />
  </label>

  <a
    href="/"
    class="docs-topbar-brand"
  >
    <Image
      source={logoSource}
      alternateSource={logoAlternateSource}
      alt={logoAlt}
      class="docs-topbar-logo"
      priority
      useDefaultEditableBinding={false}
    />
    {
      version && (
        <span
          class="docs-topbar-version"
          data-toggle-hidden={showVersionNumber ? undefined : ""}
        >
          {version}
        </span>
      )
    }
  </a>

  <div class="docs-topbar-end">
    {
      topbarLinks.length > 0 && (
        <nav
          class="docs-topbar-links"
          aria-label="Site"
          data-editable="array"
          data-prop="@data[header].topbarLinks"
        >
          {topbarLinks.map((link: TopbarLink) => (
            <a
              href={link.path}
              aria-current={link.path === pathname ? "page" : undefined}
              data-editable="array-item"
            >
              <span
                data-editable="text"
                data-type="span"
                data-prop="name"
              >
                {link.name}
              </span>
            </a>
          ))}
        </nav>
      )
    }
    <Search
      placeholder={searchPlaceholder}
      data-toggle-hidden={search ? undefined : ""}
    />
    <ThemeToggle data-toggle-hidden={themeToggle ? undefined : ""} />
  </div>
</header>

<style is:global>
  @layer components {
    .docs-topbar {
      align-items: center;
      background-color: var(--color-bg);
      border-bottom: var(--border-width-sm) solid var(--color-border);
      display: flex;
      gap: var(--spacing-md);
      height: var(--docs-topbar-height);
      padding-inline: var(--spacing-lg);
      position: sticky;
      top: 0;
      z-index: var(--layer-4);
    }

    .docs-topbar-drawer-trigger {
      align-items: center;
      border: var(--border-width-sm) solid var(--color-border);
      border-radius: var(--radius-sm);
      color: var(--color-text);
      cursor: pointer;
      display: none;
      flex: none;
      height: 2.125rem;
      justify-content: center;
      width: 2.125rem;

      svg {
        height: 1.125rem;
        width: 1.125rem;
      }
    }

    .docs-topbar-brand {
      align-items: center;
      color: var(--color-text-strong);
      display: flex;
      flex: none;
      gap: var(--spacing-sm);
      text-decoration: none;
    }

    .docs-topbar .docs-topbar-logo {
      --docs-topbar-logo-height: 1.75rem;

      > .image-inner picture {
        width: auto;
      }

      > .image-inner img {
        height: var(--docs-topbar-logo-height);
        width: auto;
      }
    }

    /* Image swaps its alternate on "toggled away from the site default", but
       these props are named light/dark, so key the swap off the live scheme. */
    html[data-theme="light"] .docs-topbar .docs-topbar-logo {
      .image-primary {
        display: block;
      }

      .image-alternate {
        display: none;
      }
    }

    html[data-theme="dark"] .docs-topbar .docs-topbar-logo:has(.image-alternate) {
      .image-primary {
        display: none;
      }

      .image-alternate {
        display: block;
      }
    }

    .docs-topbar-version {
      border: var(--border-width-sm) solid var(--color-border);
      border-radius: var(--radius-xs);
      color: var(--color-text-muted);
      font-family: var(--font-mono);
      font-size: var(--font-size-xs);
      font-weight: var(--font-weight-semibold);
      padding: 0.125rem var(--spacing-xs);
    }

    .docs-topbar-end {
      align-items: center;
      display: flex;
      gap: var(--spacing-sm);
      margin-inline-start: auto;
      min-width: 0;
    }

    .docs-topbar-links {
      align-items: center;
      display: flex;
      gap: var(--spacing-md);
      margin-inline-end: var(--spacing-sm);

      a {
        color: var(--color-text-muted);
        font-size: var(--font-size-sm);
        font-weight: var(--font-weight-semibold);
        text-decoration: none;

        &:hover,
        &[aria-current="page"] {
          color: var(--color-text-strong);
        }
      }
    }

    @media (width < 1024px) {
      .docs-topbar-drawer-trigger {
        display: flex;
      }
    }

    @media (width < 640px) {
      .docs-topbar {
        padding-inline: var(--spacing-md);
      }

      .docs-topbar-links {
        display: none;
      }
    }
  }
</style>
