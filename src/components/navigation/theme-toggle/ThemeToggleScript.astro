---
/**
 * Precedence: stored choice, then `defaultTheme`, then the OS only when that is `system`.
 * `data-theme` on `<html>` is a baseline each section flips relative to its own default.
 */
const { defaultTheme = "system" } = Astro.props;
---

<script is:inline data-default-mode={defaultTheme}>
  (function () {
    function flipTheme(theme) {
      return theme === "dark" ? "light" : "dark";
    }

    var root = document.documentElement;
    var configured = document.currentScript.getAttribute("data-default-mode") || "system";

    root.setAttribute("data-default-mode", configured);

    var defaultTheme = root.getAttribute("data-theme") || "light";
    var systemTheme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
    var theme =
      localStorage.getItem("theme") || (configured === "system" ? systemTheme : configured);
    var isToggled = theme !== defaultTheme;

    Array.from(
      new Set(
        [root].concat(
          Array.prototype.slice.call(
            document.querySelectorAll(
              '[data-theme="light"]:not([data-theme-lock]), [data-theme="dark"]:not([data-theme-lock])'
            )
          )
        )
      )
    ).forEach(function (element) {
      var elementTheme = element.getAttribute("data-theme");

      if (elementTheme === "light" || elementTheme === "dark") {
        element.setAttribute("data-default-theme", elementTheme);
        element.setAttribute("data-theme", isToggled ? flipTheme(elementTheme) : elementTheme);
      }
    });

    if (isToggled) {
      root.setAttribute("data-theme-toggled", "");
    }
  })();
</script>
