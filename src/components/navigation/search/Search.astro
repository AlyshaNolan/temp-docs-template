---
/**
 * Site-wide search: an icon trigger in the nav that opens a modal built on
 * `ModalShell` + Pagefind 1.5's Component UI. Enabled via `search: true` in
 * `src/data/docsSite.json` (optional `searchPlaceholder`). Site chrome like
 * `theme-toggle` — no CloudCannon YAML, wired by hand in `DocsTopbar.astro`.
 *
 * The index under `/pagefind/` is generated by the Pagefind CLI on build;
 * see `setup.ts` for the dev-server and CloudCannon-editor story.
 */
import Button from "@core-elements/button/Button.astro";
import Icon from "@core-elements/icon/Icon.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import ModalShell from "@wrappers/modal/ModalShell.astro";
import SearchResult from "./SearchResult.astro";

const {
  placeholder = "Search this site…",
  triggerLabel = "Search docs",
  class: className,
  ...htmlAttributes
} = Astro.props;

const popoverId = "search-modal";

// Skeleton rows Pagefind shows while lazily rendering off-screen results.
const placeholderTemplate = `
  <li class="search-result is-placeholder" aria-hidden="true">
    <p class="search-skeleton search-skeleton-title"></p>
    <p class="search-skeleton search-skeleton-line"></p>
    <p class="search-skeleton search-skeleton-line is-short"></p>
  </li>
`;
---

<div
  class:list={["search", className]}
  {...htmlAttributes}
>
  <button
    type="button"
    class="search-trigger"
    popovertarget={popoverId}
    popovertargetaction="show"
  >
    <Icon
      name="magnifying-glass"
      size="none"
    />
    <span class="search-trigger-label">{triggerLabel}</span>
    <kbd class="search-trigger-key">⌘K</kbd>
  </button>
  <ModalShell
    popoverId={popoverId}
    size="md"
    label="Search"
    fullScreenMobile
    class="search-popover"
  >
    <pagefind-config bundle-path="/pagefind/"></pagefind-config>
    <div class="search-header">
      <div class="search-input">
        <pagefind-input placeholder={placeholder}></pagefind-input>
      </div>
      <Button
        iconName="x-mark"
        hideText
        text="Close"
        variant="ghost"
        size="lg"
        class="search-close"
        popovertarget={popoverId}
        popovertargetaction="hide"
      />
    </div>
    <div class="search-body">
      <SimpleText
        text="Search works on the published site — the index is generated at build time."
        size="sm"
        class="search-unavailable"
      />
      <pagefind-summary default-message="Start typing to search this site."></pagefind-summary>
      <pagefind-results>
        <script
          is:inline
          type="text/pagefind-template"
          data-template="placeholder"
          set:html={placeholderTemplate}
        />
      </pagefind-results>
      <template class="search-result-template">
        <SearchResult />
      </template>
    </div>
    <!-- Static hints instead of <pagefind-keyboard-hints>, whose "esc clear"
         hint is wrong here — Escape closes the modal (see setup.ts). -->
    <div
      class="search-footer"
      aria-hidden="true"
    >
      <span><kbd>↓</kbd>navigate</span>
      <span><kbd>↵</kbd>open</span>
      <span><kbd>esc</kbd>close</span>
    </div>
  </ModalShell>
</div>

<script>
  import { onPageLoad } from "@component-utils/onPageLoad";
  import { setupAllSearch } from "./setup";

  onPageLoad(() => setupAllSearch());
</script>

<style is:global>
  @import "@pagefind/component-ui/css/pagefind-component-ui.css" layer(pagefind);

  @layer components {
    .search {
      display: inline-flex;
    }

    .search-trigger {
      align-items: center;
      background-color: var(--color-bg-surface);
      border: var(--border-width-sm) solid var(--color-border);
      border-radius: var(--radius-sm);
      color: var(--color-text-muted);
      cursor: pointer;
      display: flex;
      font: inherit;
      font-size: var(--font-size-sm);
      gap: var(--spacing-sm);
      height: 2.125rem;
      padding-inline: var(--spacing-sm) var(--spacing-xs);

      &:hover {
        border-color: var(--color-border-strong);
        color: var(--color-text);
      }

      svg {
        height: 1rem;
        width: 1rem;
      }
    }

    .search-trigger-key {
      border: var(--border-width-sm) solid var(--color-border-strong);
      border-radius: var(--radius-xs);
      color: var(--color-text-faint);
      font-family: var(--font-mono);
      font-size: var(--font-size-xs);
      padding: 0 var(--spacing-xs);
    }

    /* The label is the first thing to go on a narrow bar; the icon and the
       shortcut still say what the control is. */
    @media (width < 900px) {
      .search-trigger-label,
      .search-trigger-key {
        display: none;
      }

      .search-trigger {
        justify-content: center;
        padding-inline: var(--spacing-sm);
        width: 2.125rem;
      }
    }

    .search-popover {
      /* Bridge Pagefind Component UI theming onto the site's semantic
         tokens, so dark mode needs no data-pf-theme wiring. */
      --pf-font: var(--font-body);
      --pf-text: var(--color-text);
      --pf-text-secondary: var(--color-text-muted);
      --pf-text-muted: var(--color-text-muted);
      --pf-background: var(--color-bg);
      --pf-border: var(--color-border);
      --pf-border-focus: var(--color-brand);
      --pf-hover: var(--color-state-hover);
      --pf-mark: var(--color-text-strong);
      --pf-outline-focus: var(--color-focus-ring);
      --pf-border-radius: var(--radius-xs);
      --pf-shadow-sm: var(--shadow-sm);
      --pf-shadow-md: var(--shadow-md);
      --pf-shadow-lg: var(--shadow-lg);
      --pf-skeleton: var(--color-bg-surface);
      --pf-skeleton-shine: var(--color-bg-muted);
      --pf-input-height: 3rem;
      --pf-summary-font-size: var(--font-size-sm);
      --pf-results-gap: 0;

      height: min(85vh, 40rem);

      @media (max-width: 639px) {
        height: 100dvh;
      }
    }

    .search-header {
      align-items: center;
      border-bottom: var(--border-width-sm) solid var(--color-border-subtle);
      display: flex;
      flex-shrink: 0;
      gap: var(--spacing-sm);
      padding: var(--spacing-sm) var(--spacing-sm) var(--spacing-sm) var(--spacing-md);

      &:focus-within {
        border-bottom-color: var(--color-text-strong);
      }

      .search-input {
        flex: 1;
        min-width: 0;
      }
    }

    .search-popover .pf-input {
      background-color: transparent;
      border: 0;
      border-radius: 0;
      box-shadow: none;
    }

    .search-body {
      display: flex;
      flex: 1;
      flex-direction: column;
      overflow-y: auto;
      padding: var(--spacing-sm) var(--spacing-sm) var(--spacing-lg);

      pagefind-summary {
        display: block;
        flex-shrink: 0;
        padding: 0 var(--spacing-sm);
      }

      pagefind-results {
        display: block;
        padding-top: var(--spacing-sm);
      }

      .search-unavailable {
        background-color: var(--color-bg-surface);
        border: var(--border-width-sm) solid var(--color-border);
        border-radius: var(--radius-xs);
        color: var(--color-text-muted);
        display: none;
        margin: 0 var(--spacing-sm);
        max-width: 44ch;
        padding: var(--spacing-md);
      }
    }

    [data-search-unavailable] {
      .search-unavailable {
        display: block;
      }

      /* The friendly notice replaces Pagefind's raw error UI (the .pf-error
         boxes and the summary's error text). */
      .pf-error,
      pagefind-summary {
        display: none;
      }
    }

    .search-result {
      border-radius: var(--radius-xs);
      display: flex;
      flex-direction: column;
      gap: var(--spacing-xs);
      padding: var(--spacing-sm);
    }

    .search-result-link,
    .search-result-sub-link {
      border-radius: var(--radius-xs);
      display: flex;
      flex-direction: column;
      gap: 0.125rem;
      padding: var(--spacing-xs) var(--spacing-sm);
      text-decoration: none;

      &:hover {
        background-color: var(--color-accent-surface);
      }
    }

    .search-result-title {
      color: var(--color-text-strong);
      font-size: var(--font-size-sm);
      font-weight: var(--font-weight-semibold);
    }

    .search-result-subs {
      display: flex;
      flex-direction: column;
      list-style: none;
      margin: 0;
      /* Indented under their page, so the hierarchy reads without a rule. */
      padding: 0 0 0 var(--spacing-md);
    }

    .search-result-sub-title {
      color: var(--color-text);
      font-size: var(--font-size-sm);
    }

    .search-result-excerpt,
    .search-result-sub-excerpt {
      color: var(--color-text-muted);
      font-size: var(--font-size-xs);
      line-height: var(--line-height-normal);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;

      mark {
        background: none;
        color: var(--color-text-strong);
        font-weight: var(--font-weight-semibold);
      }
    }

    .search-skeleton {
      /* An ambient loop, not a UI transition — off the --animation-* scale on
         purpose, which tops out at half a second. */
      --search-skeleton-duration: 1.4s;

      animation: search-skeleton-pulse var(--search-skeleton-duration) var(--ease-in-out) infinite;
      background-color: var(--color-bg-muted);
      border-radius: var(--radius-xs);
    }

    .search-skeleton-title {
      height: 1rem;
      width: 44%;
    }

    .search-skeleton-line {
      height: 0.75rem;
      width: 100%;

      &.is-short {
        width: 72%;
      }
    }

    @keyframes search-skeleton-pulse {
      0%,
      100% {
        opacity: 1;
      }

      50% {
        opacity: 0.45;
      }
    }

    .search-footer {
      align-items: center;
      background-color: var(--color-bg-surface);
      border-top: var(--border-width-sm) solid var(--color-border);
      color: var(--color-text-muted);
      display: flex;
      flex-shrink: 0;
      font-size: var(--font-size-xs);
      gap: var(--spacing-md);
      padding: var(--spacing-sm) var(--spacing-md);

      kbd {
        background-color: var(--color-bg);
        border: var(--border-width-sm) solid var(--color-border);
        border-radius: var(--radius-xs);
        color: var(--color-text);
        font-family: var(--font-body);
        margin-inline-end: var(--spacing-em-xs);
        padding: 0 var(--spacing-xs);
      }

      @media (max-width: 639px) {
        display: none;
      }
    }
  }
</style>
