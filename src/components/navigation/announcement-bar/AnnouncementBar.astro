---
import { renderMarkdownInline } from "@component-utils/markdown";
import Icon from "@core-elements/icon/Icon.astro";

const {
  enabled = false,
  text = "",
  class: className,
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const message = typeof text === "string" ? text.trim() : "";

if (!enabled || !message) return;
---

<aside
  class:list={["announcement-bar", className]}
  aria-label="Announcement"
  {...htmlAttributes}
>
  <p
    class="announcement-bar-text"
    data-announcement={message}
  >
    <Fragment set:html={renderMarkdownInline(message)} />
  </p>
  <button
    type="button"
    class="announcement-bar-close tap-target"
    aria-label="Dismiss announcement"
  >
    <Icon
      name="x-mark"
      size="sm"
    />
  </button>
</aside>

<script is:inline data-astro-rerun>
  // is:inline so the dismissed check runs synchronously during parsing,
  // before the bar can paint, and data-astro-rerun so the ClientRouter
  // re-executes it when a client-side navigation swaps in a fresh bar.
  // CloudCannon's editor strips inline scripts, which is the behaviour we
  // want there: editors always see the bar, and the close button is inert
  // instead of hiding the thing they're editing.
  (function () {
    var bar = document.querySelector(".announcement-bar:not([data-announcement-initialized])");

    if (!bar) return;
    bar.setAttribute("data-announcement-initialized", "");

    var KEY = "announcement-bar-dismissed";
    var text = bar.querySelector(".announcement-bar-text");
    var message = (text && text.getAttribute("data-announcement")) || "";

    // Dismissal stores the message itself, so publishing a different
    // announcement makes the bar reappear for everyone.
    if (localStorage.getItem(KEY) === message) {
      bar.remove();

      return;
    }

    var close = bar.querySelector(".announcement-bar-close");

    if (close) {
      close.addEventListener("click", function () {
        localStorage.setItem(KEY, message);
        bar.remove();
      });
    }
  })();
</script>

<style is:global>
  @layer page-sections {
    /* The accent tint, not the brand fill: this sits above the header on every
       page, so it has to read as an aside a reader can dismiss rather than the
       loudest thing on screen. The accent-coloured link is what carries it. */
    .announcement-bar {
      align-items: center;
      background-color: var(--color-accent-surface);
      border-bottom: var(--border-width-sm) solid var(--color-accent-border);
      color: var(--color-text);
      display: flex;
      font-size: var(--font-size-sm);
      justify-content: center;
      padding-block: var(--spacing-sm);
      padding-inline: var(--spacing-2xl);
      position: relative;
      text-align: center;

      > .announcement-bar-text {
        color: var(--color-text);
        margin: 0;

        > a {
          color: var(--color-accent);
          font-weight: var(--font-weight-semibold);
          text-decoration: underline;
          text-underline-offset: 0.2em;
        }
      }

      > .announcement-bar-close {
        background: none;
        border: none;
        border-radius: var(--radius-sm);
        color: var(--color-text-muted);
        cursor: pointer;
        display: flex;
        inset-inline-end: var(--spacing-sm);
        padding: var(--spacing-xs);
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
      }

      > .announcement-bar-close:hover {
        opacity: 0.75;
      }
    }
  }
</style>
