---
/**
 * Registers click-to-copy on prose headings. Renders nothing — it exists so the
 * behaviour is opted into by a layout rather than running on every page.
 */
---

<script>
  import { onPageLoad } from "@component-utils/onPageLoad";
  import { setupHeadingLinks } from "./setup";

  onPageLoad(setupHeadingLinks);
</script>

<style is:global>
  @layer components {
    .heading-link-toast {
      background-color: var(--color-bg-inverse);
      border-radius: var(--radius-sm);
      bottom: var(--spacing-lg);
      color: var(--color-text-inverse);
      font-size: var(--font-size-sm);
      inset-inline-start: 50%;
      opacity: 0;
      padding: var(--spacing-sm) var(--spacing-md);
      pointer-events: none;
      position: fixed;
      transform: translate(-50%, var(--spacing-sm));
      transition:
        opacity var(--animation-normal) var(--ease-out),
        transform var(--animation-normal) var(--ease-out);
      z-index: var(--layer-8);
    }

    .heading-link-toast[data-visible] {
      opacity: 1;
      transform: translate(-50%, 0);
    }
  }
</style>
