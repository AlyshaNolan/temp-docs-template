---
/**
 * Floating control that opens the site theme in a CloudCannon data panel.
 *
 * Ships `hidden`: `setup.ts` reveals it only inside the Visual Editor, so a
 * visitor never sees a button that would do nothing for them.
 */
import Icon from "@core-elements/icon/Icon.astro";
---

<div
  class="theme-selector"
  hidden
>
  <button
    type="button"
    class="theme-selector-trigger"
    aria-label="Edit site theme"
  >
    <Icon
      name="swatch"
      size="md"
    />
  </button>
</div>

<style is:global>
  @layer components {
    .theme-selector {
      --theme-selector-size: 3rem;
      --theme-selector-inset: var(--spacing-lg);

      position: fixed;
      inset-block-end: var(--theme-selector-inset);
      inset-inline-end: var(--theme-selector-inset);
      z-index: var(--layer-7);
    }

    .theme-selector-trigger {
      display: grid;
      place-items: center;
      inline-size: var(--theme-selector-size);
      block-size: var(--theme-selector-size);
      padding: 0;
      border: var(--border-width-sm) solid var(--color-accent-border);
      border-radius: var(--radius-full);
      background-color: var(--color-accent);
      box-shadow: var(--shadow-lg);
      color: var(--color-accent-on);
      cursor: pointer;
      transition: transform var(--animation-fast) var(--ease-out);
    }

    .theme-selector-trigger:hover {
      transform: scale(1.06);
    }
  }
</style>
