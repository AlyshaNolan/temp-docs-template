---
/**
 * "Was this page helpful?" — a real form, so it works with no JavaScript.
 *
 * The default `action` posts to the site itself, which CloudCannon Forms
 * captures with no extra setup. Point `feedback.action` in
 * `src/data/docsSite.json` at any endpoint (Formspree, Netlify, your own
 * handler) to send it elsewhere; the payload is `page` + `vote`.
 */
const {
  prompt = "Was this page helpful?",
  action = "/",
  successMessage = "Thanks — that's logged against this page.",
  page = "",
  class: className,
  ...htmlAttributes
} = Astro.props;
---

<div
  class:list={["page-feedback", className]}
  {...htmlAttributes}
>
  <form
    method="post"
    action={action}
    class="page-feedback-form"
  >
    <input
      type="hidden"
      name="form-name"
      value="page-feedback"
    />
    <input
      type="hidden"
      name="page"
      value={page}
    />
    <span class="page-feedback-prompt">{prompt}</span>
    <div class="page-feedback-actions">
      <button
        type="submit"
        name="vote"
        value="yes"
      >
        Yes
      </button>
      <button
        type="submit"
        name="vote"
        value="no"
      >
        No
      </button>
    </div>
  </form>
  <p
    class="page-feedback-status"
    role="status"
    tabindex="-1"
    hidden
  >
    {successMessage}
  </p>
</div>

<script>
  import { onPageLoad } from "@component-utils/onPageLoad";
  import { setupAllPageFeedback } from "./setup";

  onPageLoad(setupAllPageFeedback);
</script>

<style is:global>
  @layer components {
    .page-feedback {
      border: var(--border-width-sm) solid var(--color-border);
      border-radius: var(--radius-md);
      margin-top: var(--spacing-xl);
      padding: var(--spacing-md) var(--spacing-lg);
    }

    .page-feedback[data-voted] .page-feedback-form {
      display: none;
    }

    .page-feedback-form {
      align-items: center;
      display: flex;
      flex-wrap: wrap;
      gap: var(--spacing-md);
      justify-content: space-between;
    }

    .page-feedback-prompt {
      font-size: var(--font-size-sm);
      font-weight: var(--font-weight-semibold);
    }

    .page-feedback-actions {
      display: flex;
      gap: var(--spacing-sm);

      button {
        background-color: var(--color-bg);
        border: var(--border-width-sm) solid var(--color-border);
        border-radius: var(--radius-sm);
        color: var(--color-text);
        cursor: pointer;
        font: inherit;
        font-size: var(--font-size-sm);
        padding: var(--spacing-xs) var(--spacing-md);
        transition: border-color var(--animation-fast) var(--ease-out);

        &:hover {
          border-color: var(--color-border-strong);
        }
      }
    }

    .page-feedback-status {
      color: var(--color-text-muted);
      font-size: var(--font-size-sm);
      margin: 0;
    }
  }
</style>
