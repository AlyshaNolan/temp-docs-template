---
import { isNonEmptyString } from "@component-utils/isNonEmptyString";
import { spaceBeforeAttr } from "@component-utils/spaceBefore.mjs";
import { renderMarkdownInline } from "@component-utils/markdown";
import { slugifyLabel } from "@component-utils/slugify";
import Icon from "@core-elements/icon/Icon.astro";

const {
  text,
  level = "h2",
  size = "default",
  alignmentHorizontal = "start",
  iconName,
  iconColor = "default",
  iconPosition = "before",
  spaceBefore = "default",
  class: className,
  useDefaultEditableBinding = false,
  "data-prop": customDataProp,
  _component,
  ...htmlAttributes
} = Astro.props;

// h2/h3 without an id cannot be cited as `#section`. Prefer `text`; most page
// sections pass the title as the default slot instead. h1 (heroes, posts) is left
// alone. Duplicate titles on the same page get a numeric suffix.
function plainTextFromHtml(html: string): string {
  return html
    .replace(/<[^>]+>/g, " ")
    .replace(/&nbsp;/gi, " ")
    .replace(/&amp;/gi, "&")
    .replace(/&lt;/gi, "<")
    .replace(/&gt;/gi, ">")
    .replace(/&quot;/gi, '"')
    .replace(/&#39;/gi, "'")
    .replace(/\s+/g, " ")
    .trim();
}

// CloudCannon's editable-regions re-render has no Astro.locals — use a
// one-shot Set so this heading still gets an id, without sharing de-dupe.
const usedHeadingIds: Set<string> = Astro.locals
  ? (Astro.locals.headingIds ??= new Set())
  : new Set();

// Rendered once, for two jobs: the anchor id, and deciding whether there is
// anything to render at all. `Astro.slots.has()` is true for a slot holding an
// empty string — which is what a page section passes when its optional heading
// is blank — so it can't answer the second question.
const slotHtml = Astro.slots.has("default") ? await Astro.slots.render("default") : "";
const hasSlotContent = slotHtml.trim().length > 0;

if (htmlAttributes.id) {
  usedHeadingIds.add(String(htmlAttributes.id));
} else if (level === "h2" || level === "h3") {
  let slugSource = isNonEmptyString(text) ? text : "";

  if (!slugSource && hasSlotContent) {
    slugSource = plainTextFromHtml(slotHtml);
  }

  const slug = slugSource ? slugifyLabel(slugSource) : "";

  if (slug) {
    let id = slug;
    let n = 2;

    while (usedHeadingIds.has(id)) {
      id = `${slug}-${n++}`;
    }

    usedHeadingIds.add(id);
    htmlAttributes.id = id;
  }
}

const effectiveDataProp = customDataProp ?? (useDefaultEditableBinding ? "text" : null);
const textDataAttributes = effectiveDataProp
  ? { "data-editable": "text", "data-prop": effectiveDataProp }
  : {};

let MarkdownText = renderMarkdownInline(text);

MarkdownText = MarkdownText.replace(/\n/g, "<br />");
const Tag = level;

const hasText = isNonEmptyString(text);

// An empty heading is not just dead space: it leaves a hole in the document
// outline, and as a flow sibling it stops the next block being a first child,
// which hands that block a top margin it should not have.
if (!_component && !hasText && !hasSlotContent) return;
---

<Tag
  class:list={["heading", "stackable", className]}
  {...htmlAttributes}
>
  <span
    class:list={[
      "heading-inner",
      size && size !== "default" && `size-${size}`,
      `align-${alignmentHorizontal}`,
    ]}
    data-space-before={spaceBeforeAttr(spaceBefore)}
  >
    {
      iconPosition == "before" && (
        <Icon
          name={iconName}
          color={iconColor}
          size="none"
          class="heading-icon"
          aria-hidden="true"
          role="presentation"
        />
      )
    }
    <span
      class="heading-text"
      {...textDataAttributes}
    >
      {
        hasSlotContent ? (
          <Fragment set:html={slotHtml} />
        ) : (
          text && <Fragment set:html={MarkdownText} />
        )
      }
    </span>
    {
      iconPosition === "after" && (
        <Icon
          name={iconName}
          color={iconColor}
          size="none"
          class="heading-icon heading-icon-after"
          aria-hidden="true"
          role="presentation"
        />
      )
    }
  </span>
</Tag>

<style is:global>
  @layer components {
    .heading {
      --space-before: var(--space-before-loose);

      margin-block: 0;

      /* Tracking is re-stated with every size below: the `<h*>` sets it in `em`
         of its own base size, which inherits as an absolute px value — so a
         smaller inner size would keep the big heading's tracking and collapse
         its words. */
      > .heading-inner {
        display: block;

        .heading-icon {
          bottom: 0.1em;
          display: inline-block;
          font-size: 0.9em;
          margin-inline-end: var(--spacing-em-xs);
          position: relative;
          vertical-align: middle;

          &.heading-icon-after {
            margin-inline: var(--spacing-em-xs) 0;
          }
        }

        &.size-xs {
          font-size: var(--font-size-heading-xs);
          letter-spacing: var(--letter-spacing-tight);
        }

        &.size-sm {
          font-size: var(--font-size-heading-sm);
          letter-spacing: var(--letter-spacing-tight);
        }

        &.size-md {
          font-size: var(--font-size-heading-md);
          letter-spacing: var(--letter-spacing-tight);
        }

        &.size-lg {
          font-size: var(--font-size-heading-lg);
          letter-spacing: var(--letter-spacing-tighter);
        }

        &.size-xl {
          font-size: var(--font-size-heading-xl);
          letter-spacing: var(--letter-spacing-tighter);
        }

        &.size-2xl {
          font-size: var(--font-size-heading-2xl);
          letter-spacing: var(--letter-spacing-display);
        }

        &.size-3xl {
          font-size: var(--font-size-heading-3xl);
          letter-spacing: var(--letter-spacing-display);
        }

        &.size-4xl {
          font-size: var(--font-size-heading-4xl);
          letter-spacing: var(--letter-spacing-display);
        }

        &.align-start {
          text-align: start;
        }

        &.align-center {
          text-align: center;
        }

        &.align-end {
          text-align: end;
        }
      }
    }
  }
</style>
