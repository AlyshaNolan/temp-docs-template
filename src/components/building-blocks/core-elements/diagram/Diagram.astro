---
/**
 * A Mermaid diagram. The source ships in the page and is replaced by SVG once
 * Mermaid loads — see `setup.ts` for why it renders client-side.
 */
import { spaceBeforeAttr } from "@component-utils/spaceBefore.mjs";

const {
  definition = "",
  caption = "",
  spaceBefore = "default",
  class: className,
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

if (!_component && !definition) return;
---

<figure
  class:list={["diagram", "stackable", className]}
  {...htmlAttributes}
>
  <div
    class="diagram-frame"
    data-space-before={spaceBeforeAttr(spaceBefore)}
  >
    <div
      class="diagram-output"
      data-diagram-output
    >
    </div>
    <pre
      class="diagram-source"
      data-diagram-source>{definition}</pre>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  import { onPageLoad } from "@component-utils/onPageLoad";
  import { setupAllDiagrams } from "./setup";

  onPageLoad(setupAllDiagrams);
</script>

<style is:global>
  @layer components {
    .diagram {
      margin: 0;
      max-width: var(--content-width-lg);
    }

    .diagram-frame {
      background-color: var(--color-bg-surface);
      border: var(--border-width-sm) solid var(--color-border);
      border-radius: var(--radius-md);
      overflow-x: auto;
      padding: var(--spacing-lg);
    }

    .diagram-source {
      color: var(--color-text-muted);
      font-family: var(--font-mono);
      font-size: var(--font-size-sm);
      margin: 0;
    }

    .diagram-output {
      display: none;

      svg {
        display: block;
        height: auto;
        margin-inline: auto;
        max-width: 100%;
      }
    }

    .diagram[data-diagram-rendered] {
      .diagram-output {
        display: block;
      }

      .diagram-source {
        display: none;
      }
    }

    /* Paper has no JavaScript: print the source, which is the diagram's
       content, rather than an empty frame. */
    @media print {
      .diagram[data-diagram-rendered] .diagram-source {
        display: block;
      }
    }
  }
</style>
