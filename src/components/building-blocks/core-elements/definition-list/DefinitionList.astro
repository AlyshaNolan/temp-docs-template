---
import { spaceBeforeAttr } from "@component-utils/spaceBefore.mjs";
import DefinitionListItem from "./DefinitionListItem.astro";

type ItemProps = Record<string, unknown>;

const {
  items,
  layout = "stacked",
  alignmentHorizontal = "start",
  spaceBefore = "default",
  class: className,
  "data-children-prop": childrenDataProp,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const effectiveChildrenProp = childrenDataProp ?? (useDefaultEditableBinding ? "items" : null);
const arrayDataAttributes = effectiveChildrenProp
  ? { "data-editable": "array", "data-prop": effectiveChildrenProp }
  : {};
const hasItems = items?.length > 0;
const hasSlotContent = Astro.slots.has("default");

if (!_component && !hasItems && !hasSlotContent) return;
---

<div
  class:list={["definition-list", "stackable", className]}
  {...htmlAttributes}
>
  <dl
    class:list={[`layout-${layout}`, `alignment-${alignmentHorizontal}`]}
    data-space-before={spaceBeforeAttr(spaceBefore)}
    {...arrayDataAttributes}
  >
    <slot>
      {
        items?.map((item: ItemProps) => (
          <DefinitionListItem
            data-id="building-blocks/core-elements/definition-list/definition-list-item"
            data-editable="array-item"
            useDefaultEditableBinding={!!effectiveChildrenProp}
            {...item}
          />
        ))
      }
    </slot>
  </dl>
</div>

<style is:global>
  @layer components {
    .definition-list {
      /* Stacked is the glossary shape: term, then its definition indented under
         it. The grid layout is for spec rows, where terms are short and the
         reader scans a column. */
      > dl.layout-stacked {
        display: block;
        margin: 0;

        > .definition-list-item + .definition-list-item {
          margin-top: var(--spacing-lg);
        }

        > .definition-list-item > .title {
          color: var(--color-text-strong);
          font-family: var(--font-mono);
          font-size: var(--font-size-sm);
          font-weight: var(--font-weight-semibold);
        }

        > .definition-list-item > .content {
          border-inline-start: var(--border-width-sm) solid var(--color-border);
          color: var(--color-text-muted);
          font-size: var(--font-size-sm);
          line-height: var(--line-height-relaxed);
          margin: var(--spacing-xs) 0 0;
          padding-inline-start: var(--spacing-md);
        }
      }

      > dl.layout-grid {
        display: grid;
        gap: var(--spacing-em-sm) var(--spacing-em-md);
        grid-template-columns: auto 1fr;
        margin: 0;

        &.alignment-center {
          align-items: center;
          grid-template-columns: 1fr 1fr;
          justify-content: center;

          > .definition-list-item > .title {
            text-align: end;
          }
        }

        &.alignment-end {
          align-items: end;
          grid-template-columns: auto auto;
          justify-content: end;

          > .definition-list-item > .title {
            text-align: start;
          }

          > .definition-list-item > .content {
            text-align: end;
          }
        }

        > .definition-list-item > .content {
          margin: 0;
        }
      }
    }
  }
</style>
