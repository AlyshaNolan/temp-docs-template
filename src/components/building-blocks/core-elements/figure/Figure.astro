---
/**
 * A captioned screenshot, optionally click-to-zoom.
 *
 * Zoom is the Popover API rather than a script, so it works in the CloudCannon
 * editor (where inline scripts don't run) and with JavaScript disabled. Pass
 * `alternateSource` for a dark-mode variant — a screenshot of a light UI on a
 * dark page is the most common reason docs images look broken.
 */
import { isNonEmptyString } from "@component-utils/isNonEmptyString";
import { slugifyLabel } from "@component-utils/slugify";
import { spaceBeforeAttr } from "@component-utils/spaceBefore.mjs";
import Image from "@core-elements/image/Image.astro";

const {
  source,
  alternateSource = null,
  alt = "",
  caption = "",
  zoom = true,
  aspectRatio = "none",
  spaceBefore = "default",
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

if (!_component && !isNonEmptyString(source)) return;

const popoverId = `figure-${slugifyLabel(String(caption || alt || source || "figure")).slice(0, 40)}`;
---

<figure
  class:list={["figure", "stackable", className]}
  {...htmlAttributes}
>
  <div
    class="figure-frame"
    data-space-before={spaceBeforeAttr(spaceBefore)}
  >
    {
      zoom ? (
        <button
          type="button"
          class="figure-zoom-trigger"
          popovertarget={popoverId}
          popovertargetaction="show"
          aria-label={`Zoom: ${alt || caption || "image"}`}
        >
          <Image
            source={source}
            alternateSource={alternateSource}
            alt={alt}
            aspectRatio={aspectRatio}
            useDefaultEditableBinding={useDefaultEditableBinding}
          />
        </button>
      ) : (
        <Image
          source={source}
          alternateSource={alternateSource}
          alt={alt}
          aspectRatio={aspectRatio}
          useDefaultEditableBinding={useDefaultEditableBinding}
        />
      )
    }
  </div>

  {
    caption && (
      <figcaption class="figure-caption">
        <span>{caption}</span>
        {zoom && <span class="figure-caption-hint">Click to zoom</span>}
      </figcaption>
    )
  }

  {
    zoom && (
      <div
        id={popoverId}
        popover="auto"
        class="figure-zoom"
      >
        <button
          type="button"
          class="figure-zoom-close"
          popovertarget={popoverId}
          popovertargetaction="hide"
        >
          Close
        </button>
        <Image
          source={source}
          alternateSource={alternateSource}
          alt={alt}
          useDefaultEditableBinding={false}
        />
      </div>
    )
  }
</figure>

<style is:global>
  @layer components {
    .figure {
      margin: 0;
      max-width: var(--content-width-lg);
    }

    .figure-frame {
      border: var(--border-width-sm) solid var(--color-border);
      border-radius: var(--radius-md);
      overflow: hidden;
    }

    .figure-zoom-trigger {
      background: none;
      border: 0;
      cursor: zoom-in;
      display: block;
      padding: 0;
      width: 100%;
    }

    .figure-caption {
      align-items: baseline;
      color: var(--color-text-faint);
      display: flex;
      flex-wrap: wrap;
      font-size: var(--font-size-sm);
      gap: var(--spacing-sm);
      justify-content: space-between;
      margin-top: var(--spacing-sm);
    }

    .figure-caption-hint {
      font-size: var(--font-size-xs);
    }

    .figure-zoom {
      background-color: transparent;
      border: 0;
      height: 100%;
      max-height: none;
      max-width: none;
      padding: var(--spacing-2xl);
      width: 100%;

      &::backdrop {
        background-color: var(--color-overlay);
      }

      img {
        display: block;
        margin-inline: auto;
        max-height: 100%;
        max-width: 100%;
        object-fit: contain;
      }
    }

    .figure-zoom-close {
      background-color: var(--color-bg);
      border: var(--border-width-sm) solid var(--color-border);
      border-radius: var(--radius-sm);
      color: var(--color-text);
      cursor: pointer;
      font: inherit;
      font-size: var(--font-size-sm);
      inset-block-start: var(--spacing-md);
      inset-inline-end: var(--spacing-md);
      padding: var(--spacing-xs) var(--spacing-md);
      position: fixed;
    }
  }
</style>
