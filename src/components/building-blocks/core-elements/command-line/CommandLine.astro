---
/**
 * A single copyable shell command — the "run this to start" line. Sits in an
 * action row beside a button, so its height matches the buttons around it.
 *
 * Built on the shared code surface's copy behaviour (`code-block/setup.ts`),
 * which is why the command carries `data-code-source`.
 */
import { spaceBeforeAttr } from "@component-utils/spaceBefore.mjs";

const {
  command = "",
  prompt = "$",
  showCopy = true,
  spaceBefore = "default",
  class: className,
  useDefaultEditableBinding = false,
  "data-prop": customDataProp,
  _component,
  ...htmlAttributes
} = Astro.props;

if (!_component && !command) return;

const effectiveDataProp = customDataProp ?? (useDefaultEditableBinding ? "command" : null);
const commandDataAttributes = effectiveDataProp
  ? { "data-editable": "text", "data-prop": effectiveDataProp }
  : {};
---

<div
  class:list={["command-line", "code-surface", "stackable", className]}
  {...htmlAttributes}
>
  <div
    class="command-line-inner"
    data-space-before={spaceBeforeAttr(spaceBefore)}
  >
    {
      prompt && (
        <span
          class="command-line-prompt"
          aria-hidden="true"
        >
          {prompt}
        </span>
      )
    }
    <code
      class="command-line-command"
      data-code-source
      {...commandDataAttributes}
    >
      {command}
    </code>
    {
      showCopy && (
        <button
          type="button"
          class="code-surface-copy"
        >
          <span class="code-surface-copy-idle">Copy</span>
          <span class="code-surface-copy-done">Copied</span>
        </button>
      )
    }
  </div>
</div>

<script>
  import { onPageLoad } from "@component-utils/onPageLoad";
  import { setupAllCodeSurfaces } from "@core-elements/code-block/setup";

  onPageLoad(setupAllCodeSurfaces);
</script>

<style is:global>
  @layer components {
    /* Overrides the code surface's dark panel: this one sits in a row of
       buttons on the page background, not around a block of code. */
    .command-line.code-surface {
      background-color: var(--color-bg-surface);
      border-color: var(--color-border);
      width: fit-content;
    }

    .command-line-inner {
      align-items: center;
      display: flex;
      gap: var(--spacing-sm);
      min-height: 2.875rem;
      padding-inline: var(--spacing-md) var(--spacing-xs);
    }

    .command-line-prompt {
      color: var(--color-text-faint);
      font-family: var(--font-mono);
      font-size: var(--font-size-sm);
    }

    .command-line-command {
      color: var(--color-text-strong);
      font-family: var(--font-mono);
      font-size: var(--font-size-sm);
      white-space: nowrap;
    }
  }
</style>
