---
import { spaceBeforeAttr } from "@component-utils/spaceBefore.mjs";
import { isNonEmptyString } from "@component-utils/isNonEmptyString";
import { renderMarkdown } from "@component-utils/markdown";
import Icon from "@core-elements/icon/Icon.astro";

const {
  variant = "note",
  title = "",
  text = "",
  iconName = "",
  spaceBefore = "default",
  class: className,
  useDefaultEditableBinding = false,
  "data-prop": customDataProp,
  "data-prop-title": customDataPropTitle,
  _component,
  ...htmlAttributes
} = Astro.props;

const MarkdownText = renderMarkdown(text);

const effectiveDataProp = customDataProp ?? (useDefaultEditableBinding ? "text" : null);
const textDataAttributes = effectiveDataProp
  ? { "data-editable": "text", "data-prop": effectiveDataProp }
  : {};

const effectiveTitleProp = customDataPropTitle ?? (useDefaultEditableBinding ? "title" : null);
const titleDataAttributes = effectiveTitleProp
  ? { "data-editable": "text", "data-prop": effectiveTitleProp }
  : {};

const hasText = isNonEmptyString(text);
const hasSlotContent = Astro.slots.has("default");

if (!_component && !hasText && !hasSlotContent && !isNonEmptyString(title)) return;
---

<div
  class:list={["alert", "stackable", className]}
  role="note"
  {...htmlAttributes}
>
  <div
    class:list={["alert-content", `variant-${variant}`]}
    data-space-before={spaceBeforeAttr(spaceBefore)}
  >
    {
      iconName && (
        <Icon
          name={iconName}
          size="none"
          class="alert-icon"
        />
      )
    }
    <div class="alert-body">
      {
        title && (
          <p
            class="alert-title"
            {...titleDataAttributes}
          >
            {title}
          </p>
        )
      }
      <div
        class="alert-text"
        {...textDataAttributes}
      >
        <slot>{hasText && <Fragment set:html={MarkdownText} />}</slot>
      </div>
    </div>
  </div>
</div>

<style is:global>
  @layer components {
    .alert {
      /* A full-width callout is unreadable — cap at prose width even inside a
         wide section. */
      max-width: var(--content-width-lg);
    }

    .alert-content {
      --alert-accent: var(--color-text-faint);
      --alert-bg: var(--color-bg-surface);

      background-color: var(--alert-bg);
      border-radius: var(--radius-md);
      border-inline-start: var(--border-width-lg) solid var(--alert-accent);
      display: flex;
      gap: var(--spacing-md);
      padding: var(--spacing-md) var(--spacing-lg);

      &.variant-note,
      &.variant-info {
        --alert-accent: var(--color-accent);
        --alert-bg: var(--color-accent-surface);
      }

      &.variant-tip {
        --alert-accent: var(--color-success);
      }

      &.variant-warning {
        --alert-accent: var(--color-warning);
      }

      &.variant-danger {
        --alert-accent: var(--color-danger);
      }
    }

    .alert .alert-icon {
      color: var(--alert-accent);
      flex-shrink: 0;
      font-size: var(--font-size-lg);
      /* Centre the icon on the first line of text rather than the box. */
      margin-top: calc((var(--line-height-normal) * var(--font-size-md) - 1em) / 2);
    }

    .alert .alert-body {
      min-width: 0;
    }

    .alert .alert-title {
      color: var(--color-text-strong);
      font-size: var(--font-size-sm);
      font-weight: var(--font-weight-semibold);
      margin: 0;
    }

    .alert .alert-text {
      color: var(--color-text-muted);
      font-size: var(--font-size-sm);
      line-height: var(--line-height-relaxed);

      p {
        color: inherit;
        font-size: inherit;
        line-height: inherit;
      }

      > :first-child {
        margin-top: 0;
      }

      > :last-child {
        margin-bottom: 0;
      }
    }

    .alert .alert-title + .alert-text {
      margin-top: var(--spacing-xs);
    }
  }
</style>
