---
/**
 * API reference entries: a name in mono, its type, whether it is required, and
 * what it does. Reference pages are the one place a table earns its keep less
 * than a list — descriptions run long and a third column of "—" is noise.
 */
import { renderMarkdown } from "@component-utils/markdown";
import { spaceBeforeAttr } from "@component-utils/spaceBefore.mjs";

type Param = {
  name?: string;
  type?: string;
  required?: boolean;
  defaultValue?: string;
  description?: string;
};

const {
  params = [] as Param[],
  spaceBefore = "default",
  class: className,
  useDefaultEditableBinding = false,
  "data-children-prop": childrenDataProp,
  _component,
  ...htmlAttributes
} = Astro.props;

const entries = (params as Param[]).filter((param) => param?.name);

if (!_component && entries.length === 0) return;

const effectiveChildrenProp = childrenDataProp ?? (useDefaultEditableBinding ? "params" : null);
const arrayDataAttributes = effectiveChildrenProp
  ? { "data-editable": "array", "data-prop": effectiveChildrenProp }
  : {};
---

<div
  class:list={["param-list", "stackable", className]}
  {...htmlAttributes}
>
  <dl
    class="param-list-items"
    data-space-before={spaceBeforeAttr(spaceBefore)}
    {...arrayDataAttributes}
  >
    {
      entries.map((param) => (
        <div
          class="param-list-item"
          data-editable={effectiveChildrenProp ? "array-item" : undefined}
          data-id={param.name}
        >
          <dt class="param-list-term">
            <code class="param-list-name">{param.name}</code>
            {param.type && <span class="param-list-type">{param.type}</span>}
            {param.defaultValue && (
              <span class="param-list-default">default {param.defaultValue}</span>
            )}
            {param.required && <span class="param-list-required">required</span>}
          </dt>
          {param.description && (
            <dd
              class="param-list-description"
              set:html={renderMarkdown(param.description)}
            />
          )}
        </div>
      ))
    }
  </dl>
</div>

<style is:global>
  @layer components {
    .param-list {
      max-width: var(--content-width-lg);
    }

    .param-list-items {
      border: var(--border-width-sm) solid var(--color-border);
      border-radius: var(--radius-md);
      margin: 0;
      overflow: hidden;
    }

    .param-list-item {
      padding: var(--spacing-md) var(--spacing-lg);

      & + & {
        border-top: var(--border-width-sm) solid var(--color-border);
      }
    }

    .param-list-term {
      align-items: baseline;
      display: flex;
      flex-wrap: wrap;
      gap: var(--spacing-sm);
    }

    .param-list-name {
      background: none;
      color: var(--color-text-strong);
      font-family: var(--font-mono);
      font-size: var(--font-size-sm);
      font-weight: var(--font-weight-semibold);
      padding: 0;
    }

    .param-list-type,
    .param-list-default {
      color: var(--color-text-faint);
      font-family: var(--font-mono);
      font-size: var(--font-size-xs);
    }

    .param-list-required {
      background-color: var(--color-accent-surface);
      border-radius: var(--radius-xs);
      color: var(--color-accent);
      font-size: var(--font-size-xs);
      font-weight: var(--font-weight-semibold);
      padding: 0 var(--spacing-xs);
    }

    /* Set explicitly rather than inherited from the prose `dd` rules — this
       renders inside a page builder too, where those don't apply. */
    .param-list-description {
      border-inline-start: var(--border-width-sm) solid var(--color-border);
      color: var(--color-text-muted);
      font-size: var(--font-size-sm);
      line-height: var(--line-height-relaxed);
      margin: var(--spacing-xs) 0 0;
      padding-inline-start: var(--spacing-md);

      p {
        color: inherit;
        font-size: inherit;
        line-height: inherit;
        margin: 0;
      }
    }
  }
</style>
