---
/**
 * A button that opens the browser's print dialog.
 *
 * It ships `hidden` and is revealed by `setup.ts` — printing needs JavaScript,
 * so with it off the reader sees nothing rather than a dead control. Every
 * browser's own print shortcut still works, which is why hiding it costs
 * nothing.
 */
import { spaceBeforeAttr } from "@component-utils/spaceBefore.mjs";
import Button from "@core-elements/button/Button.astro";

const {
  text = "Open print preview",
  variant = "primary",
  size = "md",
  iconName = "printer",
  iconPosition = "before",
  spaceBefore = "default",
  class: className,
  useDefaultEditableBinding = false,
  "data-prop": customDataProp,
  _component,
  ...htmlAttributes
} = Astro.props;

const effectiveDataProp = customDataProp ?? (useDefaultEditableBinding ? "text" : null);
---

<div
  class:list={["print-button", "stackable", className]}
  hidden
  {...htmlAttributes}
>
  <div data-space-before={spaceBeforeAttr(spaceBefore)}>
    <Button
      text={text}
      variant={variant}
      size={size}
      iconName={iconName}
      iconPosition={iconPosition}
      data-prop={effectiveDataProp}
    />
  </div>
</div>

<script>
  import { onPageLoad } from "@component-utils/onPageLoad";
  import { setupAllPrintButtons } from "./setup";

  onPageLoad(setupAllPrintButtons);
</script>

<style is:global>
  @layer components {
    .print-button {
      width: fit-content;
    }

    /* Printing the page that offers the button would print the button. */
    @media print {
      .print-button {
        display: none !important;
      }
    }
  }
</style>
