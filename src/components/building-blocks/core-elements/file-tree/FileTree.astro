---
import { drawFileTree } from "@component-utils/fileTree";
import { highlightCode, parseDiffMarkers } from "@component-utils/highlight";
import { spaceBeforeAttr } from "@component-utils/spaceBefore.mjs";
import CodeBlockSurface from "../code-block/CodeBlockSurface.astro";

const {
  paths = "",
  title = "",
  showCopy = false,
  spaceBefore = "default",
  class: className,
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

if (!_component && !paths) return;

// Blank lines go before the markers are read, so the diff line numbers below
// still index the rendered tree one-for-one.
const source = String(paths)
  .split("\n")
  .filter((line) => line.trim())
  .join("\n");

const { lines, diff } = parseDiffMarkers(source, { preserveColumns: true });
const html = await highlightCode(drawFileTree(lines).join("\n"), "text", { diff });
---

<div
  class:list={["file-tree", "stackable", className]}
  {...htmlAttributes}
>
  <CodeBlockSurface
    showCopy={showCopy}
    data-space-before={spaceBeforeAttr(spaceBefore)}
  >
    {
      title && (
        <span
          slot="header"
          class="code-surface-label"
        >
          {title}
        </span>
      )
    }
    <div
      data-code-source
      set:html={html}
    />
  </CodeBlockSurface>
</div>

<script>
  import { onPageLoad } from "@component-utils/onPageLoad";
  import { setupAllCodeSurfaces } from "../code-block/setup";

  onPageLoad(setupAllCodeSurfaces);
</script>
