---
import { highlightCode, parseLineRanges } from "@component-utils/highlight";
import { spaceBeforeAttr } from "@component-utils/spaceBefore.mjs";
import CodeBlockSurface from "./CodeBlockSurface.astro";

const {
  code = "",
  language = "js",
  filename = "",
  highlight = "",
  showCopy = true,
  spaceBefore = "default",
  class: className,
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

if (!_component && !code) return;

const html = await highlightCode(String(code), String(language), {
  highlight: parseLineRanges(highlight),
});
const label = filename || language;
---

<div
  class:list={["code-block", "stackable", className]}
  {...htmlAttributes}
>
  <CodeBlockSurface
    showCopy={showCopy}
    data-space-before={spaceBeforeAttr(spaceBefore)}
  >
    {
      label && (
        <span
          slot="header"
          class="code-surface-label"
        >
          {label}
        </span>
      )
    }
    <div
      data-code-source
      set:html={html}
    />
  </CodeBlockSurface>
</div>

<script>
  import { onPageLoad } from "@component-utils/onPageLoad";
  import { setupAllCodeSurfaces } from "./setup";

  onPageLoad(setupAllCodeSurfaces);
</script>
