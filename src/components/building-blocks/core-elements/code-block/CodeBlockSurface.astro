---
/**
 * Shared by `CodeBlock`, `CodeTabs`, `CodeAnnotations`, `CodeDiff` and `FileTree`,
 * and owns the `.code-*` styles they rely on. Copy reads `.innerText` of
 * `[data-code-source]`, so only the code carries it — never a header or footer.
 */
const { showCopy = true, class: className, ...htmlAttributes } = Astro.props;
const hasHeader = Astro.slots.has("header");
---

<div
  class:list={["code-surface", className]}
  {...htmlAttributes}
>
  {
    (hasHeader || showCopy) && (
      <div class="code-surface-header">
        <div class="code-surface-header-start">
          <slot name="header" />
        </div>
        {showCopy && (
          <button
            type="button"
            class="code-surface-copy"
          >
            <span class="code-surface-copy-idle">Copy</span>
            <span class="code-surface-copy-done">Copied</span>
          </button>
        )}
      </div>
    )
  }
  <slot />
</div>

<style is:global>
  @layer components {
    .code-surface {
      --code-diff-gutter: 1.25rem;

      background-color: var(--color-code-bg);
      border: var(--border-width-sm) solid var(--color-code-border);
      border-radius: var(--radius-md);
      overflow: hidden;
    }

    .code-surface-header {
      align-items: center;
      background-color: var(--color-bg-surface);
      border-bottom: var(--border-width-sm) solid var(--color-border);
      display: flex;
      gap: var(--spacing-md);
      justify-content: space-between;
      min-height: 2.5rem;
      padding: 0 var(--spacing-sm) 0 var(--spacing-md);
    }

    .code-surface-header-start {
      align-items: center;
      display: flex;
      gap: var(--spacing-xs);
      min-width: 0;
    }

    .code-surface-label {
      color: var(--color-text-muted);
      font-family: var(--font-mono);
      font-size: var(--font-size-xs);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .code-surface-copy {
      background: none;
      border: none;
      border-radius: var(--radius-xs);
      color: var(--color-text-muted);
      cursor: pointer;
      flex: none;
      font: inherit;
      font-size: var(--font-size-xs);
      padding: var(--spacing-xs) var(--spacing-sm);

      &:hover {
        background-color: var(--color-state-hover);
        color: var(--color-text-strong);
      }
    }

    .code-surface-copy-done {
      display: none;
    }

    .code-surface-copy[data-state="copied"] {
      .code-surface-copy-idle {
        display: none;
      }

      .code-surface-copy-done {
        display: inline;
      }
    }

    /* `.astro-code` is a Markdown fence and must look identical to `.code-pre`.
       A fence in prose keeps the margins `base/_prose.css` gives it. */
    .code-surface .code-pre {
      margin: 0;
    }

    .code-surface .code-pre,
    .prose .astro-code {
      background-color: var(--color-code-bg);
      color: var(--color-code-text);
      font-size: var(--font-size-sm);
      line-height: var(--line-height-normal);
      overflow-x: auto;
      padding: 0;
      tab-size: 2;

      /* Grid, not block: Shiki's newline text nodes between `.line` spans render
         as empty lines under `display: block`. Padding stays off the `<pre>`,
         where it would push a fence's `::before` header off the panel's top. */
      code {
        display: grid;
        font-family: var(--font-mono);
        min-width: max-content;
        padding-block: var(--spacing-md);
      }

      .line {
        display: block;
        padding-inline: var(--spacing-md);
      }

      .line.is-highlighted {
        background-color: var(--color-code-highlight);
        box-shadow: inset var(--border-width-md) 0 0 var(--color-accent);
      }
    }

    /* The +/- signs must stay `::before` content so copy (`.innerText`) omits them. */
    .code-surface:has(.line[data-diff]) .line {
      padding-inline-start: calc(var(--spacing-md) + var(--code-diff-gutter));
      position: relative;
    }

    .code-surface .line[data-diff]::before {
      inset-inline-start: var(--spacing-md);
      position: absolute;
    }

    .code-surface .line[data-diff="add"] {
      background-color: var(--color-code-diff-add-bg);

      &::before {
        color: var(--color-code-diff-add-text);
        content: "+";
      }
    }

    .code-surface .line[data-diff="remove"] {
      background-color: var(--color-code-diff-remove-bg);

      &::before {
        color: var(--color-code-diff-remove-text);
        content: "-";
      }
    }

    .code-surface .line[data-diff="highlight"] {
      background-color: var(--color-code-highlight);
      box-shadow: inset var(--border-width-md) 0 0 var(--color-accent);
    }
  }
</style>
