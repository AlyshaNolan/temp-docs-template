---
/**
 * The release history, read from the `changelog` collection — one file per
 * release, newest first. Releases are content, not props, so nothing here is
 * inline-editable: a new release is a new collection entry.
 *
 * Each version heading is a real `h2` so it anchors like any other section.
 */
import { renderMarkdown } from "@component-utils/markdown";
import { slugifyLabel } from "@component-utils/slugify";
import { spaceBeforeAttr } from "@component-utils/spaceBefore.mjs";
import { getCollection } from "astro:content";

const {
  limit = 0,
  spaceBefore = "loose",
  class: className,
  _component,
  ...htmlAttributes
} = Astro.props;

const collection = await getCollection("changelog");
const sorted = collection.sort(
  (a, b) =>
    b.data.date.getTime() - a.data.date.getTime() ||
    b.data.version.localeCompare(a.data.version, undefined, { numeric: true })
);
const releases = limit > 0 ? sorted.slice(0, limit) : sorted;

const releaseDate = (date: Date) =>
  date.toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" });
---

<section
  class:list={["changelog", "stackable", className]}
  {...htmlAttributes}
>
  <div
    class="changelog-inner"
    data-space-before={spaceBeforeAttr(spaceBefore)}
  >
    {
      releases.map((release) => (
        <article class="changelog-release">
          <div class="changelog-release-header">
            <h2 id={slugifyLabel(release.data.version)}>{release.data.version}</h2>
            <span class="changelog-release-date">{releaseDate(release.data.date)}</span>
          </div>
          {release.data.summary && (
            <div
              class="changelog-release-summary"
              set:html={renderMarkdown(release.data.summary)}
            />
          )}
          {release.data.changes.length > 0 && (
            <ul class="changelog-changes">
              {release.data.changes.map((change) => (
                <li>
                  {change.tag && (
                    <span class:list={["changelog-tag", `is-${slugifyLabel(change.tag)}`]}>
                      {change.tag}
                    </span>
                  )}
                  <span set:html={renderMarkdown(change.text)} />
                </li>
              ))}
            </ul>
          )}
        </article>
      ))
    }
  </div>
</section>

<style is:global>
  @layer components {
    .changelog {
      max-width: var(--content-width-lg);
    }

    .changelog-inner {
      display: flex;
      flex-direction: column;
      gap: var(--space-before-loose);
    }

    .changelog-release-header {
      align-items: baseline;
      border-bottom: var(--border-width-sm) solid var(--color-border);
      display: flex;
      flex-wrap: wrap;
      gap: var(--spacing-sm);
      padding-bottom: var(--spacing-sm);

      h2 {
        font-size: var(--font-size-heading-sm);
        letter-spacing: var(--letter-spacing-tight);
        margin: 0;
      }
    }

    .changelog-release-date {
      color: var(--color-text-faint);
      font-family: var(--font-mono);
      font-size: var(--font-size-xs);
    }

    .changelog-release-summary {
      color: var(--color-text-muted);
      font-size: var(--font-size-sm);
      line-height: var(--line-height-relaxed);
      margin-top: var(--spacing-md);

      > :first-child {
        margin-top: 0;
      }

      > :last-child {
        margin-bottom: 0;
      }
    }

    .changelog-changes {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-sm);
      list-style: none;
      margin: var(--spacing-md) 0 0;
      padding: 0;

      li {
        align-items: baseline;
        color: var(--color-text-muted);
        display: flex;
        font-size: var(--font-size-sm);
        gap: var(--spacing-sm);
        line-height: var(--line-height-relaxed);
      }

      p {
        color: inherit;
        font-size: inherit;
        line-height: inherit;
        margin: 0;
      }
    }

    .changelog-tag {
      background-color: var(--color-bg-muted);
      border-radius: var(--radius-xs);
      color: var(--color-text-muted);
      flex: none;
      font-family: var(--font-mono);
      font-size: var(--font-size-xs);
      min-width: 4.5rem;
      padding: 0 var(--spacing-xs);
      text-align: center;

      &.is-breaking {
        background-color: var(--color-danger-bg-subtle);
        color: var(--color-danger);
      }

      &.is-added {
        background-color: var(--color-success-bg-subtle);
        color: var(--color-success);
      }
    }
  }
</style>
