---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Text from "@core-elements/text/Text.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";

const {
  eyebrow = "",
  eyebrowShowDot = false,
  heading = "",
  headingLevel = "h1",
  subtext = "",
  alignmentHorizontal = "center",
  buttonSections = [],
  sectionLabel,
  maxContentWidth = "2xl",
  paddingHorizontal = "lg",
  paddingVertical = "4xl",
  colorScheme = "inherit",
  lockColorScheme = false,
  backgroundColor = "base",
  background,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;
---

<CustomSection
  class:list={["hero-center", className]}
  label={sectionLabel}
  maxContentWidth={maxContentWidth}
  paddingHorizontal={paddingHorizontal}
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  lockColorScheme={lockColorScheme}
  backgroundColor={backgroundColor}
  background={background}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  {
    eyebrow && (
      <p class:list={["hero-center-eyebrow", `align-${alignmentHorizontal}`]}>
        <span class="hero-center-pill">
          {eyebrowShowDot && (
            <span
              class="hero-center-dot"
              aria-hidden="true"
            />
          )}
          <span
            data-editable="text"
            data-prop="eyebrow"
          >
            {eyebrow}
          </span>
        </span>
      </p>
    )
  }
  <Heading
    level={headingLevel}
    size="2xl"
    alignmentHorizontal={alignmentHorizontal}
    data-prop="heading"
    data-type="block"
    text={heading}
  />
  <Text
    alignmentHorizontal={alignmentHorizontal}
    class="subtext"
    size="lg"
    data-prop="subtext"
    text={subtext}
  />
  <ButtonGroup
    class="buttonSections"
    buttonSections={buttonSections}
    alignmentHorizontal={alignmentHorizontal}
    data-children-prop="buttonSections"
  />
</CustomSection>

<style is:global>
  @layer page-sections {
    .hero-center {
      /* A display heading set across a wide column reads as one long line; the
         cap is what gives it the two-line break the design has. Centre-aligned
         heroes already sit in a narrower measure. */
      &:has(.heading-inner.align-start) {
        .heading,
        .subtext {
          max-width: var(--content-width-lg);
        }
      }

      /* Two flow overrides, both because a display heading needs different air
         than body text: the pill is chrome for the heading rather than a block
         of its own (`loose` would put 48px between them), and a lede set 8px
         under a -0.045em h1 reads as though it collided with it.
         Set through `--space-before`, not a margin — the utils layer wins over
         a raw `margin-top` here, which `npm run test:flow-margins` catches. */
      .hero-center-eyebrow + .heading {
        --space-before: var(--space-before-default);
      }

      > .outer-content > .content > .subtext {
        --space-before: var(--space-before-default);
      }

      .hero-center-eyebrow {
        display: flex;
        margin: 0;

        &.align-center {
          justify-content: center;
        }

        &.align-start {
          justify-content: flex-start;
        }
      }

      .hero-center-pill {
        align-items: center;
        background-color: var(--color-bg-surface);
        border: var(--border-width-sm) solid var(--color-border);
        border-radius: var(--radius-full);
        color: var(--color-text-muted);
        display: inline-flex;
        font-size: var(--font-size-xs);
        gap: var(--spacing-sm);
        padding: var(--spacing-xs) var(--spacing-md);
      }

      .hero-center-dot {
        background-color: var(--color-accent);
        border-radius: var(--radius-full);
        flex: none;
        height: 0.375rem;
        width: 0.375rem;
      }
    }
  }
</style>
