---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Icon from "@core-elements/icon/Icon.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Text from "@core-elements/text/Text.astro";

type FeatureItem = {
  title?: string;
  description?: string;
  iconName?: string;
  iconColor?: string;
};

const {
  eyebrow = "",
  heading = "",
  headingLevel = "h2",
  subtext = "",
  alignmentHorizontal = "start",
  items = [],
  columns = 3,
  gap = "md",
  rounded = false,
  sectionLabel,
  maxContentWidth = "2xl",
  paddingHorizontal = "lg",
  paddingVertical = "4xl",
  colorScheme = "inherit",
  lockColorScheme = false,
  backgroundColor = "surface",
  background,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;
---

<CustomSection
  class:list={["feature-list", className]}
  label={sectionLabel}
  maxContentWidth={maxContentWidth}
  paddingHorizontal={paddingHorizontal}
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  lockColorScheme={lockColorScheme}
  backgroundColor={backgroundColor}
  background={background}
  rounded={rounded}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  <SimpleText
    alignmentHorizontal={alignmentHorizontal}
    class="eyebrow"
    data-prop="eyebrow"
    text={eyebrow}
    size="sm"
  />
  <Heading
    level={headingLevel}
    size="xs"
    alignmentHorizontal={alignmentHorizontal}
    data-prop="heading"
    text={heading}
  />
  <Text
    alignmentHorizontal={alignmentHorizontal}
    data-prop="subtext"
    text={subtext}
  />
  {
    items?.length > 0 && (
      <div
        class:list={["feature-list-frame", `gap-${gap}`]}
        style={`--feature-list-columns: ${columns}`}
      >
        <ul
          class="feature-list-grid"
          data-editable="array"
          data-prop="items"
          data-direction="row"
        >
          {items?.map((item: FeatureItem) => (
            <li
              class="feature-list-item"
              data-editable="array-item"
            >
              <Icon
                name={item.iconName}
                color={item.iconColor}
                size="sm"
                class="feature-list-item-icon"
              />
              <span
                class="feature-list-item-title"
                data-editable="text"
                data-prop="title"
              >
                {item.title}
              </span>
              {item.description && (
                <>
                  <span
                    class="feature-list-item-separator"
                    aria-hidden="true"
                  >
                    {" — "}
                  </span>
                  <span
                    class="feature-list-item-description"
                    data-editable="text"
                    data-prop="description"
                  >
                    {item.description}
                  </span>
                </>
              )}
            </li>
          ))}
        </ul>
      </div>
    )
  }
</CustomSection>

<style is:global>
  @layer page-sections {
    .feature-list {
      .feature-list-frame {
        --space-before: var(--space-before-tight);
        container-type: inline-size;
      }

      .feature-list-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        list-style: none;
        margin: 0;
        padding: 0;

        /* An exact track count, container-queried: `columns` is a count, and an
           auto-fit track list quietly adds one of its own as soon as the
           container is wide enough for another. */
        @container (width >= 640px) {
          grid-template-columns: repeat(var(--feature-list-columns, 3), minmax(0, 1fr));
        }

        > * {
          min-width: 0;
        }
      }

      .feature-list-frame.gap-sm .feature-list-grid {
        gap: var(--spacing-sm) var(--spacing-lg);
      }

      .feature-list-frame.gap-md .feature-list-grid {
        gap: var(--spacing-md) var(--spacing-xl);
      }

      .feature-list-frame.gap-lg .feature-list-grid {
        gap: var(--spacing-lg) var(--spacing-2xl);
      }

      /* One flowing line per entry — label, dash, detail — rather than a stack.
         Two lines per entry reads as nine cards and doubles the block's height;
         this is a list to scan, not a feature grid. */
      .feature-list-item {
        font-size: var(--font-size-sm);
        line-height: var(--line-height-normal);
        margin: 0;
      }

      .feature-list-item-icon {
        color: var(--color-text-muted);
        margin-inline-end: var(--spacing-xs);
        vertical-align: text-bottom;
      }

      .feature-list-item-title {
        font-weight: var(--font-weight-semibold);
      }

      .feature-list-item-separator {
        color: var(--color-text-muted);
      }
    }
  }
</style>
