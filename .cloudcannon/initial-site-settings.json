{
  "ssg": "astro",
  "mode": "hosted",
  "build": {
    "install_command": "npm i",
    "build_command": "npm run build",
    "output_path": "dist",
    "preserved_paths": "node_modules,.astro",
    "environment_variables": [],
    "manually_configure_urls": true,
    "preserveOutput": true,
    "includeGit": true,
    "hugoVersion": "0.128.1",
    "rubyVersion": "2.7.3",
    "nodeVersion": "24",
    "denoVersion": "1.40.2"
  }
}
